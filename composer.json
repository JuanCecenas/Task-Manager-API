{
    "name": "juancecenas/task-manager-api",
    "description": "Task Manager API in pure PHP with clean architecture",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Juan Cecenas",
            "email": "juancarlos.cecenasrojas@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "robmorgan/phinx": "^0.16.11",
        "vlucas/phpdotenv": "^5.6"
    },
    "scripts": {
       "phinx-create": "./vendor/bin/phinx create --configuration=./config/phinx.php ",
       "phinx-migrate": "./vendor/bin/phinx migrate --configuration=./config/phinx.php",
       "phinx-rollback": "./vendor/bin/phinx rollback --configuration=./config/phinx.php",
       "phinx-status": "./vendor/bin/phinx status --configuration=./config/phinx.php"
    }
}
